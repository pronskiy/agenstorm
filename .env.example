# Copy to .env and fill in. .env is gitignored; this file is not.
# Nothing loads it automatically — export it first:  set -a; . ./.env; set +a

# GitHub token for this repository, used for gh/API calls from the working session.
# Fine-grained token; give it the permissions you actually need (Contents, Actions,
# and Administration if you want to edit the repo description, topics or secrets).
GH_TOKEN=

# --- JetBrains Marketplace publishing and plugin signing ---
# The four secrets .github/workflows/release.yml passes to `./gradlew publishPlugin`.
# build.gradle.kts reads them with providers.environmentVariable(...), so nothing loads this
# file on its own — export it first:  set -a; . ./.env; set +a
#
# PUBLISH_TOKEN          Marketplace personal access token, scope "Plugin upload".
#                        https://plugins.jetbrains.com/author/me/tokens
# CERTIFICATE_CHAIN      Signing certificate chain, the whole PEM text including the
#                        -----BEGIN CERTIFICATE----- lines. Multi-line, so quote it:
#                        CERTIFICATE_CHAIN="-----BEGIN CERTIFICATE-----
#                        ...
#                        -----END CERTIFICATE-----"
# PRIVATE_KEY            Signing private key, PEM text, quoted the same way.
# PRIVATE_KEY_PASSWORD   Passphrase for that key.
#                        https://plugins.jetbrains.com/docs/intellij/plugin-signing.html
PUBLISH_TOKEN=
CERTIFICATE_CHAIN=
PRIVATE_KEY=
PRIVATE_KEY_PASSWORD=
