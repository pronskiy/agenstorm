<!-- Epic G: `open path` opens in this IDE.
     Loaded only when the bundled Terminal plugin is present; every other feature works without it. -->
<idea-plugin>
    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <!-- G1.4: the shim directory goes in front of a new terminal's PATH, with the endpoint's port and
             token in the environment. The EP is @ApiStatus.Experimental (SPEC.md §2 accepts that). -->
        <shellExecOptionsCustomizer implementation="com.pronskiy.agenstorm.terminal.TerminalOpenExecOptionsCustomizer"/>
        <!-- U1.4 (decision 90): a new tab's shell inside a tmux session. LocalTerminalCustomizer is deprecated, not
             internal, and is the one public way to replace the command; MutableShellExecOptions.setExecCommand is internal. -->
        <localTerminalCustomizer implementation="com.pronskiy.agenstorm.terminal.tmux.TmuxShellCustomizer"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Epic I (I1.3 spike, then I2.1): fold regions over the blocks the enhancer rules recognise in the
             reworked terminal's output editor. -->
        <editorFactoryListener implementation="com.pronskiy.agenstorm.terminal.enhance.TerminalEnhancerEditorListener"/>
        <postStartupActivity implementation="com.pronskiy.agenstorm.terminal.enhance.TerminalEnhancerStartupActivity"/>
        <!-- U3.1: a project's background terminals are tabs of its window again when it opens. -->
        <postStartupActivity implementation="com.pronskiy.agenstorm.terminal.tmux.TmuxReattach"/>
        <!-- U3.2: closing a project with a tmux tab running something asks to keep it or stop it. -->
        <projectCloseHandler implementation="com.pronskiy.agenstorm.terminal.tmux.TmuxProjectCloseHandler"/>
        <!-- U3.3: "N background terminals" in every window's status bar while there are any. -->
        <statusBarWidgetFactory id="agenstorm.backgroundTerminals" implementation="com.pronskiy.agenstorm.terminal.tmux.BackgroundTerminalsWidgetFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.pronskiy.agenstorm">
        <!-- P2.4: a terminal tab with a command running keeps its project loaded. -->
        <offloadGuard implementation="com.pronskiy.agenstorm.core.busy.TerminalCommandGuard"/>
        <!-- T2.5: a new worktree's setup runs in a reworked terminal tab. -->
        <worktreeSetupTerminal implementation="com.pronskiy.agenstorm.worktrees.setup.ReworkedSetupTerminal"/>
        <!-- U2.2: a worktree switch hands the tmux sessions running something to the new window. -->
        <projectHandOff implementation="com.pronskiy.agenstorm.terminal.tmux.TerminalHandOff"/>
        <!-- U4.1: removing, archiving or merging back a worktree sees, and can end, the tmux sessions inside it. -->
        <folderProcesses implementation="com.pronskiy.agenstorm.terminal.tmux.TmuxFolderProcesses"/>
    </extensions>

    <applicationListeners>
        <!-- U3.2: acting on a close's or a quit's answer once the close is certain. -->
        <listener class="com.pronskiy.agenstorm.terminal.tmux.TmuxProjectClosing" topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <projectListeners>
        <!-- U1.6 (decision 92): ✕ on a tmux tab running something asks, with the platform's dialog. -->
        <listener class="com.pronskiy.agenstorm.terminal.tmux.TmuxTabsListener"
                  topic="com.intellij.terminal.frontend.toolwindow.TerminalTabsManagerListener"/>
    </projectListeners>

    <actions resource-bundle="messages.AgenstormBundle">
        <!-- J1.3: the maximize toggle joins the terminal's title bar, next to "New Tab". The group belongs to
             the Terminal plugin, so the button is registered here while the action itself stays in plugin.xml
             and works (hidden) in IDEs without that plugin. -->
        <reference ref="Agenstorm.ToggleTerminalMaximized">
            <add-to-group group-id="TerminalToolwindowActionGroup" anchor="first"/>
        </reference>
        <!-- U3.3: "N background terminals" next to it, shown only while there are any. -->
        <action id="Agenstorm.BackgroundTerminals" class="com.pronskiy.agenstorm.terminal.tmux.BackgroundTerminalsAction"
                icon="AllIcons.Nodes.Console">
            <add-to-group group-id="TerminalToolwindowActionGroup" anchor="after" relative-to-action="Agenstorm.ToggleTerminalMaximized"/>
        </action>
    </actions>
</idea-plugin>
