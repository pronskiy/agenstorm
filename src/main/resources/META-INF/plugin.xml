<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.pronskiy.agenstorm</id>
    <name>Agenstorm</name>
    <vendor url="https://pronskiy.com" email="roman@pronskiy.com">Roman Pronskiy</vendor>

    <!-- <idea-version since-build/until-build> is patched in by the Gradle build from
         pluginSinceBuild / pluginUntilBuild in gradle.properties (262 / 262.*). -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.vcs</depends>

    <!-- Optional dependencies: one config file per feature package that needs a bundled plugin.
         The plugin must load (and every core feature must work) in IDEs where these are absent. -->
    <depends optional="true" config-file="agenstorm-markdown.xml">org.intellij.plugins.markdown</depends>
    <depends optional="true" config-file="agenstorm-php.xml">com.jetbrains.php</depends>
    <depends optional="true" config-file="agenstorm-git.xml">Git4Idea</depends>
    <depends optional="true" config-file="agenstorm-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.AgenstormBundle</resource-bundle>

    <extensionPoints>
        <!-- commit: repository facts for the prompt ({branch}); the Git provider is registered in agenstorm-git.xml. -->
        <extensionPoint qualifiedName="com.pronskiy.agenstorm.commitContextProvider"
                        interface="com.pronskiy.agenstorm.commit.context.CommitContextProvider"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <!-- AgenstormSettings is a light @Service (no XML registration needed). -->
        <applicationConfigurable parentId="tools"
                                 id="com.pronskiy.agenstorm"
                                 instance="com.pronskiy.agenstorm.core.AgenstormConfigurable"
                                 key="settings.display.name"
                                 bundle="messages.AgenstormBundle"/>

        <!-- links: path:line[:col] tokens in comments of every language (keyed collector, see ReferenceProviderType). -->
        <referenceProviderType key="commentsReferenceProvider"
                               implementationClass="com.pronskiy.agenstorm.links.comments.CommentLocationReferenceProvider"/>
        <!-- links: Go to Declaration for hosts whose getReferences() does not consult the registry (PHPDoc & co). -->
        <gotoDeclarationHandler implementation="com.pronskiy.agenstorm.links.LocationGotoDeclarationHandler"/>

        <!-- commit: balloons for generation failures and hints. -->
        <notificationGroup id="Agenstorm" displayType="BALLOON" bundle="messages.AgenstormBundle" key="notification.group.agenstorm"/>

        <!-- tabs: macOS window tabs stay on (they merge the projects into one window); their row is hidden so the header
             keeps one line. Also gives the registry key back if Agenstorm 1.0 turned it off, and feeds the tabs model. -->
        <postStartupActivity implementation="com.pronskiy.agenstorm.tabs.TabsStartupActivity"/>

        <!-- frame: window title without the file name. Service override allowed by SPEC.md §2; fails soft. -->
        <applicationService serviceInterface="com.intellij.openapi.wm.impl.FrameTitleBuilder"
                            serviceImplementation="com.pronskiy.agenstorm.frame.ProjectOnlyFrameTitleBuilder"
                            overrides="true"/>
    </extensions>

    <applicationListeners>
        <!-- tabs: closed projects leave the tab strip. -->
        <listener class="com.pronskiy.agenstorm.tabs.TabsProjectCloseListener" topic="com.intellij.openapi.project.ProjectCloseListener"/>
        <!-- tabs: the main-toolbar project slot becomes a strip of project tabs, taken before the first toolbar
             is built and given back when the feature is switched off or the plugin is unloaded. -->
        <listener class="com.pronskiy.agenstorm.tabs.ProjectTabsWidgetLifecycleListener" topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="com.pronskiy.agenstorm.tabs.ProjectTabsWidgetUnloadListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
        <!-- scratch: the New Scratch File action becomes ours, showing only the allow-listed languages; the
             platform's own action is put back when the feature goes off or the plugin is unloaded. -->
        <listener class="com.pronskiy.agenstorm.scratch.ScratchLifecycleListener" topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="com.pronskiy.agenstorm.scratch.ScratchUnloadListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions resource-bundle="messages.AgenstormBundle">
        <!-- tabs: keyboard navigation between project windows in tab order; no default shortcuts (README suggests some). -->
        <action id="Agenstorm.NextProjectTab" class="com.pronskiy.agenstorm.tabs.NextProjectTabAction"/>
        <action id="Agenstorm.PrevProjectTab" class="com.pronskiy.agenstorm.tabs.PrevProjectTabAction"/>
        <action id="Agenstorm.CloseProjectTab" class="com.pronskiy.agenstorm.tabs.CloseProjectTabAction"/>

        <!-- terminal: fill the window with the terminal, and put the editor back. The button is added to the
             terminal's own title bar in agenstorm-terminal.xml, which loads only when that plugin is present.
             This is the one action that ships a default binding (decision 40 narrows decision 12), and it is
             the same one on every platform: ⌥⇧F12, one shift away from ⌥F12, which activates the terminal
             everywhere. It carries no macOS override — `alt shift F12` needs none, since the Ctrl/Meta swap
             the mac keymaps apply to inherited shortcuts leaves it alone.
             TerminalMaximizeToggleActionTest asks the keymaps themselves whether anything else claims it. A
             text search cannot answer that, and a search is what let the first version of this binding pick
             ⌘⌥M, which fires Extract Method: `control alt M` in $default *is* ⌘⌥M on macOS, and the string
             appears in no keymap file. Caught before it shipped. Decision 45. -->
        <action id="Agenstorm.ToggleTerminalMaximized"
                class="com.pronskiy.agenstorm.terminal.TerminalMaximizeToggleAction"
                icon="AllIcons.General.ExpandComponent">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift F12"/>
        </action>

        <!-- links: copies relpath:line[:col] for the caret / selection start / clicked gutter line. No default shortcut. -->
        <action id="Agenstorm.CopyLocationLink"
                class="com.pronskiy.agenstorm.links.CopyLocationLinkAction"
                icon="AllIcons.Actions.Copy">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Copy.Paste.Special"/>
            <add-to-group group-id="EditorGutterPopupMenu" anchor="last"/>
        </action>
        <!-- commit: generate / stop generating a commit message; toolbar above the message field. -->
        <action id="Agenstorm.GenerateCommitMessage"
                class="com.pronskiy.agenstorm.commit.GenerateCommitMessageAction"
                icon="AllIcons.Actions.Lightning">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
