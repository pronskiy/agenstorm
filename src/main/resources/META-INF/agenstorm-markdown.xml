<!-- Loaded only when the Markdown plugin (org.intellij.plugins.markdown) is present.
     Epic A (path:line:col links in Markdown link destinations) and Epic F (live markup) register their extensions here. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- referenceClass matters: the reference service only asks providers whose declared class fits the
             caller's hint, and HyperlinkAnnotator asks for PsiHighlightedReference. -->
        <psi.symbolReferenceProvider hostLanguage="Markdown"
                                     hostElementClass="org.intellij.plugins.markdown.lang.psi.impl.MarkdownLinkDestination"
                                     implementationClass="com.pronskiy.agenstorm.links.markdown.MarkdownLocationReferenceProvider"
                                     referenceClass="com.pronskiy.agenstorm.links.FileLocationSymbolReference"
                                     targetClass="com.pronskiy.agenstorm.links.FileLocationSymbol"/>
        <lang.inspectionSuppressor language="Markdown"
                                   implementationClass="com.pronskiy.agenstorm.links.markdown.LocationLinkInspectionSuppressor"/>

        <!-- markdown (Epic F): live markup attaches to every main editor of a Markdown file. Public listener on purpose:
             the platform's TextEditorCustomizer hook is @ApiStatus.Internal and not on the SPEC.md §2 list. -->
        <editorFactoryListener implementation="com.pronskiy.agenstorm.markdown.LiveMarkupEditorListener"/>
        <!-- markdown (Epic F): bold/italic/strike/link styling for files in live markup, only where the scheme lacks it. -->
        <annotator language="Markdown" implementationClass="com.pronskiy.agenstorm.markdown.LiveMarkupAnnotator"/>
        <!-- markdown (Epic F): Go to Declaration from the visible text of an inline link answers with the hidden destination. -->
        <gotoDeclarationHandler implementation="com.pronskiy.agenstorm.markdown.LinkTextGotoDeclarationHandler"/>
    </extensions>
</idea-plugin>
