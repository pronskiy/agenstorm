<!-- Loaded only when the Git plugin (Git4Idea) is present.
     Epic D: the current branch name for the commit message prompt ({branch}). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.pronskiy.agenstorm">
        <commitContextProvider implementation="com.pronskiy.agenstorm.commit.context.GitCommitContextProvider"/>
        <!-- worktrees (Epic T): a linked worktree's project is named "<main checkout>:<worktree>" in the tabs and the title. -->
        <projectNameProvider implementation="com.pronskiy.agenstorm.worktrees.WorktreeProjectNames"/>
    </extensions>

    <!-- tabs (Phase E3): the Git branch moves from the main toolbar to the status bar's left slot. -->
    <extensions defaultExtensionNs="com.intellij">
        <statusBarWidgetFactory id="agenstorm.branch"
                                implementation="com.pronskiy.agenstorm.tabs.git.BranchStatusBarWidgetFactory"
                                order="first"/>
        <postStartupActivity implementation="com.pronskiy.agenstorm.tabs.git.BranchStartupActivity"/>
    </extensions>

    <!-- worktrees (Epic T): the worktrees of the project's repository, kept current (T1.2), and the strip above the Project tree (T1.4). -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.pronskiy.agenstorm.worktrees.WorktreeStartupActivity"/>
        <!-- T1.7: .worktrees/ and .claude/worktrees/ stay out of the project that holds them, and out of its VCS roots. -->
        <directoryIndexExcludePolicy implementation="com.pronskiy.agenstorm.worktrees.WorktreeExcludePolicy"/>
        <!-- ...and out of the Project pane too, as .idea is; Project Files still lists them. -->
        <treeStructureProvider implementation="com.pronskiy.agenstorm.worktrees.ui.WorktreeFolderFilter"/>
    </extensions>
    <actions>
        <!-- Hides the stock VCS group (branch, merge/rebase, create repository) while the branch lives in the status bar. -->
        <group id="MainToolbarVCSGroup" class="com.pronskiy.agenstorm.tabs.git.VcsToolbarGroup" overrides="true"/>
    </actions>
</idea-plugin>
